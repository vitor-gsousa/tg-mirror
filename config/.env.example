# Telegram API (required, get these at my.telegram.org)
API_ID=123456
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Session (required: use SESSION_STRING or let the app create a
# local SESSION.session file on first login)

# Telethon string session. Preferred for Docker (no interactive login,
# session isn't tied to a local file).
SESSION_STRING=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Name used for the local .session file when SESSION_STRING is not set.
# Ignored if SESSION_STRING is set. (optional, default: mirror)
SESSION=mirror

# Destination Chat (required) - chat ID where messages will be mirrored to
DEST_CHAT=-1009999999999

# Source Chats (required, comma-separated) - chat IDs to monitor
SOURCE_CHATS=-1001111111111,-1002222222222,-1003333333333

# Web Interface
# Admin password for the control panel (required)
ADMIN_PASSWORD=strong_password_here

# Port the web interface listens on (optional, default: 8000)
WEB_PORT=8000

# Secret used to sign session cookies. Set this to a random string, or
# sessions will be invalidated on every restart. (optional)
SESSION_SECRET=your_random_secret_here

# Cosmetic dashboard header info (optional)
DASHBOARD_VERSION=2026.07.02
DASHBOARD_DEPLOY_NOTE=

# DB Cleanup (optional)
# Retention period in days for processed-message/dedup records. Set to 0 to
# disable automatic cleanup. (default: 30)
CLEANUP_DAYS=30
# Daily cleanup run time, HH:MM 24h format, host local time.
# (default: 00:05)
CLEANUP_TIME=00:05

# Code de-duplication (optional)
# Regex used to extract alphanumeric codes from messages for dedup.
# (default: \b[A-Za-z0-9]{6,}\b)
DUP_CODE_REGEX=\b[A-Z0-9]{10}\b